{
  "name": "nutri-sense-monorepo",
  "version": "1.0.0",
  "packageManager": "npm@11.12.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/iot/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test": "turbo run test",
    "openapi:generate": "turbo run openapi:generate",
    "android:emulate": "npm run emulate -w @nutrisense/mobile",
    "android:install": "npm run android:install -w @nutrisense/mobile",
    "android:run": "npm run android:run -w @nutrisense/mobile",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "latest"
  }
}
